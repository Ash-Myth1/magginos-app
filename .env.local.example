# ─────────────────────────────────────────────────────────────────────────────
# .env.local.example — Local development secrets (never committed to git)
# Copy your values from:
#   Firebase Console → Project Settings → Your Apps → Firebase SDK snippet
#   EmailJS Dashboard → Account → API Keys / Services / Templates
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase ──────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── EmailJS ───────────────────────────────────────────────────────────────────
# EmailJS Dashboard → Email Services → your service → Service ID
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx

# EmailJS Dashboard → Email Templates → "New Order Confirmation" → Template ID
VITE_EMAILJS_TEMPLATE_NEW_ORDER=template_xxxxxxx

# EmailJS Dashboard → Email Templates → "Order Delivered" → Template ID
VITE_EMAILJS_TEMPLATE_DELIVERED=template_xxxxxxx

# EmailJS Dashboard → Account → Public Key
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
